+# 無効化された領域を空白化する（文字位置は変えない）。
+function Get-EnabledText {
+    param(
+        [string]$Text,
+        $DisabledRanges
+    )
+
+    if ($null -eq $DisabledRanges -or $DisabledRanges.Count -eq 0) { return $Text }
+    return (New-BlankedCopy -Text $Text -Ranges $DisabledRanges)
+}

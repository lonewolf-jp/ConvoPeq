{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": ["context-mode"],
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["C:/Users/user/.local/bin/serena.exe", "start-mcp-server", "--context", "ide", "--project", "C:/VSC_Project/ConvoPeq", "--mode", "editing", "--add-mode", "interactive"],
      "enabled": true
    },
    "headroom": {
      "type": "local",
      "command": [".venv/Scripts/headroom.exe", "mcp", "serve"],
      "enabled": true
    },
    "aidex": {
      "type": "local",
      "command": ["node", "C:/Users/user/AppData/Roaming/npm/node_modules/aidex-mcp/build/index.js"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      }
    },
    "brave": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server", "--transport", "stdio"],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "mslearn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    }
  }
}

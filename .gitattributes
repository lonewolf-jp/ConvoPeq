# Git Attributes for ConvoPeq
# UTF-8エンコーディング保持設定

# ── 自前ソースコード: LF 統一 ──
*.cpp text eol=lf
*.h   text eol=lf
*.c   text eol=lf
*.hpp text eol=lf

# ── ビルド設定 ──
CMakeLists.txt text eol=lf
*.cmake        text eol=lf
*.json         text eol=lf

# ── ドキュメント（WSL grep 対象になるもの） ──
*.md   text eol=lf
*.txt  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# ── シェルスクリプト（WSL/Linux 実行前提） ──
*.sh text eol=lf

# ── 外部依存（strictly read-only、CRLF 維持） ──
/JUCE/**              text eol=crlf
/r8brain-free-src/**  text eol=crlf

# ── Windows バッチファイル ──
*.bat text eol=crlf working-tree-encoding=UTF-8
build.bat text eol=crlf working-tree-encoding=UTF-8

# ── Visual Studio 設定 ──
*.ps1 text eol=crlf
.vscode/*.json text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.sln text eol=crlf

# ── バイナリファイル ──
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.wav binary
*.aif binary
*.aiff binary
*.flac binary
*.mp3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.tgz binary
